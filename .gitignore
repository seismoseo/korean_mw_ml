# Python, notebooks, editors
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.claude/

# Per-event working results (about 450 MB), regenerated by run_catalog.py and local_magnitude.py.
# Their sizes and SHA-256 are listed in tables/MANIFEST.csv.
/events/
/spectra/
/station_logs/
/ml_events/
/logs/

# Reproducible per-event caches and logs of the small-event feasibility pilot.
/small_events/events/
/small_events/spectra/
/small_events/station_logs/
/small_events/ml_events/
/small_events/logs/
/small_events/short_windows/events/
/small_events/short_windows/spectra/
/small_events/nw2_windows/events/
/small_events/nw2_windows/spectra/
/small_events/extension/events/
/small_events/extension/ml_events/
/small_events/extension/station_logs/
/small_events/extension/spectra/
/small_events/extension/nw2_windows/events/
/small_events/extension/nw2_windows/spectra/
/small_events/extension/logs/

# Published losslessly as .csv.gz to fit GitHub's per-file limit.
# Keep the canonical CSV locally; restore it after cloning with gzip -dk.
/small_events/extension/tables/magnitude_scaling_predictions.csv

# Raw waveforms, instrument responses and third-party catalogs: not redistributed (see README).
/inputs/Sangju_counts/
/inputs/master_velocity.xml
/inputs/KR_Mw/*.csv
/hh_hg_comparison/inputs/events/
/hh_hg_comparison/inputs/cutouts/
/hh_hg_comparison/inputs/responses/
/hh_hg_comparison/inputs/necis/
/hh_hg_comparison/inputs/*.log
/hh_hg_comparison/spectra/

# Papers keep their publishers' copyright; references/README.md lists them.
/references/*.pdf

# Plain-text copies of the PDF reports, written next to them by the report scripts.
/reports/*.txt
/hh_hg_comparison/reports/*.txt

# PDF copies of the Markdown documents, for reading on the server.
/README.pdf
/docs/*.pdf
/hh_hg_comparison/README.pdf
/references/README.pdf
*.pdfbuild.log
